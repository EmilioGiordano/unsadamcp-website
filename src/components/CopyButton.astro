---
interface Props {
  text: string;
  label: string;
}

const { text, label } = Astro.props;
---

<button type="button" class="copy-button" data-copy={text} aria-label={label} title={label}>
  <svg class="icon-copy" viewBox="0 0 16 16" aria-hidden="true">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.6"></rect>
    <path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.2"></path>
  </svg>
  <svg class="icon-done" viewBox="0 0 16 16" aria-hidden="true">
    <path d="m3.5 8.5 3 3 6-7"></path>
  </svg>
  <span class="toast" aria-live="polite"></span>
</button>

<style>
  .copy-button {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--text-3);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-s);
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s,
      border-color 0.15s;
  }

  .copy-button:hover {
    color: var(--text);
    background: var(--bg-raised);
    border-color: var(--line-strong);
  }

  svg {
    grid-area: 1 / 1;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.15s,
      transform 0.15s;
  }

  .icon-done {
    opacity: 0;
    transform: scale(0.6);
    stroke-width: 1.8;
  }

  .copy-button[data-copied] {
    color: var(--accent);
  }

  .copy-button[data-copied] .icon-copy {
    opacity: 0;
    transform: scale(0.6);
  }

  .copy-button[data-copied] .icon-done {
    opacity: 1;
    transform: none;
  }

  .toast {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    padding: 3px 8px;
    border-radius: var(--radius-s);
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-body);
    font-size: 0.74rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }

  .copy-button[data-copied] .toast {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const toast = button.querySelector<HTMLElement>(".toast");
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.dataset.copied = "";
      if (toast) toast.textContent = "Copiado";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        if (toast) toast.textContent = "";
      }, 1600);
    });
  }
</script>
