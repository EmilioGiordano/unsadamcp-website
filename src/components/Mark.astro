---
interface Props {
  size?: number;
}

const { size = 38 } = Astro.props;
---

<svg class="mark" height={size} width={Math.round((size * 79) / 114)} viewBox="0 0 79 114" aria-hidden="true">
  <path class="top" d="M39.5 0 57 17.5 39.5 35 22 17.5Z"></path>
  <path class="base" d="M0 39 17.5 21.5 39.5 43.5 61.5 21.5 79 39 39.5 78.5Z"></path>
  <text x="39.5" y="113" text-anchor="middle" textLength="79" lengthAdjust="spacing">MCP</text>
</svg>

<style>
  .mark {
    flex: none;
  }

  .top {
    fill: var(--mark-gold);
  }

  .base,
  text {
    fill: var(--mark-ink);
  }

  text {
    font-family: var(--font-display);
    font-size: 33px;
    font-weight: 700;
  }
</style>
