---
import { sessions } from "../data/sessions";
---

<div class="session" data-session>
  <div class="top">
    <span class="status"><span class="led" aria-hidden="true"></span>unsada conectado</span>
    <div class="tabs" role="tablist" aria-label="Ejemplos de preguntas">
      {
        sessions.map((session, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${session.id}`}
            aria-controls={`panel-${session.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            {session.label}
          </button>
        ))
      }
    </div>
  </div>

  {
    sessions.map((session, index) => (
      <section
        class="panel"
        role="tabpanel"
        id={`panel-${session.id}`}
        aria-labelledby={`tab-${session.id}`}
        hidden={index !== 0}
      >
        <p class="ask" data-step data-type>
          {session.prompt}
        </p>

        <ol class="calls">
          {session.calls.map((call) => (
            <li class="call" data-step data-call>
              <span class="glyph" aria-hidden="true" />
              <code class="tool">{call.tool}</code>
              {call.args && <code class="args">{call.args}</code>}
              <span class="result">{call.result}</span>
            </li>
          ))}
        </ol>

        <div class="answer">
          {session.answer.map((block) => {
            if (block.kind === "text") return <p data-step>{block.text}</p>;
            if (block.kind === "points")
              return (
                <ul class="points" data-step>
                  {block.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              );
            if (block.kind === "rows")
              return (
                <table class="rows" data-step>
                  <caption class="visually-hidden">Entregas de la semana</caption>
                  <tbody>
                    {block.rows.map((row) => (
                      <tr>
                        <td class="day">{row.day}</td>
                        <td class="time">{row.time}</td>
                        <td class="what">
                          <strong>{row.what}</strong>
                          <span>{row.where}</span>
                        </td>
                        <td class="flag">{row.flag && <span>{row.flag}</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              );
            return (
              <div class="files" data-step>
                <p class="folder">{block.folder}/</p>
                <ul>
                  {block.files.map((file) => (
                    <li>
                      <span>{file.name}</span>
                      {file.note && <em>{file.note}</em>}
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </section>
    ))
  }

  <div class="composer" aria-hidden="true">
    <span>Preguntale algo sobre tus materias</span>
    <kbd>Enter</kbd>
  </div>
</div>

<style>
  .session {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    background: var(--bg-raised);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 40px 80px -40px rgb(0 0 0 / 0.55);
    overflow: hidden;
    min-height: 560px;
  }

  :global([data-theme="light"]) .session {
    box-shadow: 0 30px 60px -36px rgb(23 24 26 / 0.22);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 10px 10px 18px;
    border-bottom: 1px solid var(--line);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-2);
    white-space: nowrap;
  }

  .led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-soft);
  }

  .tabs {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 9px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs button {
    font: inherit;
    font-size: 0.82rem;
    color: var(--text-2);
    background: none;
    border: 0;
    border-radius: 6px;
    padding: 5px 11px;
    cursor: pointer;
    white-space: nowrap;
  }

  .tabs button:hover {
    color: var(--text);
  }

  .tabs button[aria-selected="true"] {
    color: var(--text);
    background: var(--bg-raised);
    box-shadow: 0 0 0 1px var(--line-strong);
  }

  .panel {
    flex: 1;
    padding: 26px 26px 12px;
    font-size: 0.95rem;
  }

  .ask {
    margin-left: auto;
    width: fit-content;
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 14px 14px 4px 14px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    min-height: 1.6em;
  }

  .calls {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .call {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    min-width: 0;
  }

  .glyph {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateY(-1px);
  }

  .tool {
    color: var(--text);
    font-size: inherit;
  }

  .args {
    color: var(--text-3);
    font-size: inherit;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    flex: 0 1 auto;
  }

  .result {
    margin-left: auto;
    flex: none;
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: 0.8rem;
  }

  .answer {
    margin-top: 22px;
    display: grid;
    gap: 14px;
    line-height: 1.55;
  }

  .rows {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }

  .rows td {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    vertical-align: baseline;
  }

  .rows tr:last-child td {
    border-bottom: 1px solid var(--line);
  }

  .day {
    width: 4.6em;
    color: var(--text-2);
  }

  .time {
    width: 3.8em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    font-weight: 500;
  }

  .what strong {
    font-weight: 500;
  }

  .what span {
    display: block;
    color: var(--text-3);
    font-size: 0.82rem;
  }

  .flag {
    text-align: right;
  }

  .flag span {
    font-size: 0.74rem;
    color: var(--no);
    background: var(--no-soft);
    border-radius: 999px;
    padding: 2px 8px;
    white-space: nowrap;
  }

  .points {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
    color: var(--text);
  }

  .points li::marker {
    color: var(--text-3);
  }

  .files {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .folder {
    color: var(--accent);
    margin-bottom: 6px;
  }

  .files ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--line-strong);
    display: grid;
    gap: 3px;
  }

  .files li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .files em {
    font-style: normal;
    font-family: var(--font-body);
    color: var(--text-3);
  }

  .composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 14px 14px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-sunken);
    color: var(--text-3);
    font-size: 0.88rem;
  }

  kbd {
    font-size: 0.72rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    padding: 1px 6px;
  }

  :global(.motion) .panel [data-step] {
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  :global(.motion) .panel [data-step]:not(.shown) {
    opacity: 0;
    transform: translateY(6px);
  }

  :global(.motion) .panel [data-call]:not(.done) .result {
    visibility: hidden;
  }

  :global(.motion) .panel [data-call].shown:not(.done) .glyph {
    animation: pulse 0.7s ease-in-out infinite alternate;
  }

  :global(.motion) .panel .ask.typing {
    opacity: 1;
    transform: none;
  }

  :global(.motion) .panel .ask.typing::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--accent);
  }

  @keyframes pulse {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.25;
    }
  }

  @media (max-width: 560px) {
    .session {
      min-height: 0;
    }

    .top {
      flex-direction: column;
      align-items: stretch;
      padding: 10px;
    }

    .status {
      padding-left: 6px;
    }

    .panel {
      padding: 20px 16px 8px;
    }

    .args {
      display: none;
    }

    .day {
      width: 4em;
    }

    .flag {
      display: none;
    }

    .composer {
      margin: 0 10px 10px;
    }
  }
</style>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  for (const root of document.querySelectorAll<HTMLElement>("[data-session]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    let run = 0;
    let autoplay = !reducedMotion;
    let visible = true;
    let advanceWhenVisible = false;
    const advance = () => select((tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true") + 1) % tabs.length);

    const play = async (panel: HTMLElement, current: number) => {
      const steps = [...panel.querySelectorAll<HTMLElement>("[data-step]")];
      const live = () => current === run;
      if (reducedMotion) return;
      for (const step of steps) step.classList.remove("shown", "done", "typing");

      for (const step of steps) {
        if (!live()) return;
        if (step.hasAttribute("data-type")) {
          const text = step.dataset.text ?? step.textContent?.trim() ?? "";
          step.dataset.text = text;
          step.textContent = "";
          step.classList.add("typing");
          await wait(350);
          for (let length = 1; length <= text.length; length++) {
            if (!live()) {
              step.textContent = text;
              return;
            }
            step.textContent = text.slice(0, length);
            await wait(22 + Math.random() * 28);
          }
          await wait(380);
          step.classList.remove("typing");
          step.classList.add("shown");
        } else if (step.hasAttribute("data-call")) {
          step.classList.add("shown");
          await wait(650 + Math.random() * 400);
          step.classList.add("done");
          await wait(160);
        } else {
          step.classList.add("shown");
          await wait(420);
        }
      }
      if (!live() || !autoplay) return;
      await wait(5200);
      if (!live() || !autoplay) return;
      if (visible) advance();
      else advanceWhenVisible = true;
    };

    const select = (index: number) => {
      run++;
      advanceWhenVisible = false;
      tabs.forEach((tab, position) => {
        const selected = position === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[position].hidden = !selected;
      });
      play(panels[index], run);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        autoplay = false;
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        autoplay = false;
        const next = (index + step + tabs.length) % tabs.length;
        tabs[next].focus();
        select(next);
      });
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && advanceWhenVisible && autoplay) advance();
    }).observe(root);

    select(0);
  }
</script>
