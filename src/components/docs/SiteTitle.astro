---
import Mark from "../Mark.astro";

import { base } from "../../lib/base";
---

<a class="site-title" href={base}>
  <Mark />
  <span class="name">unsada-mcp</span>
  <span class="section">docs</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .section {
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
  }
</style>
