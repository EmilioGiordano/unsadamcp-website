---
import CopyButton from "./CopyButton.astro";

interface Props {
  command: string;
}

const { command } = Astro.props;
const [program, ...words] = command.split(" ");
---

<div class="copy-command">
  <span class="prompt" aria-hidden="true">$</span>
  <code
    ><span class="program">{program}</span>{
      words.map((word) => (
        <>
          {" "}
          <span class:list={[word.startsWith("-") ? "flag" : word.includes("unsada") ? "package" : "word"]}>{word}</span>
        </>
      ))
    }</code
  >
  <CopyButton text={command} label="Copiar comando" />
</div>

<style>
  .copy-command {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 50px;
    padding: 0 9px 0 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    background: var(--term-bg);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    max-width: 100%;
    transition: border-color 0.15s;
  }

  .copy-command:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line-strong));
  }

  .prompt {
    color: var(--accent);
    user-select: none;
  }

  code {
    flex: 1;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    font-size: inherit;
    color: var(--text-2);
  }

  .program {
    color: var(--text);
    font-weight: 500;
  }

  .flag {
    color: var(--text-3);
  }

  .package {
    color: var(--accent);
  }
</style>
