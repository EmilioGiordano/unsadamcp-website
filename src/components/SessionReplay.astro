---
import { sessions } from "../data/sessions";
import WindowLights from "./WindowLights.astro";
---

<div class="session" data-session>
  <div class="chrome">
    <WindowLights />
    <span class="title">~/Facultad · tu agente</span>
    <span class="status"><span class="led" aria-hidden="true"></span>unsada conectado</span>
  </div>

  <div class="tabs" role="tablist" aria-label="Ejemplos de pedidos">
    {
      sessions.map((session, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${session.id}`}
          aria-controls={`panel-${session.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          {session.label}
        </button>
      ))
    }
  </div>

  <div class="screen" data-screen>
    {
      sessions.map((session, index) => (
        <section
          class="panel"
          role="tabpanel"
          id={`panel-${session.id}`}
          aria-labelledby={`tab-${session.id}`}
          hidden={index !== 0}
        >
          <p class="ask" data-step data-type>
            {session.prompt}
          </p>

          {session.steps.map((step) => {
            if (step.kind === "think")
              return (
                <p class="think" data-step>
                  {step.text}
                </p>
              );
            if (step.kind === "plan")
              return (
                <ul class="plan" data-step>
                  {step.tasks.map((task) => (
                    <li class="done" data-task>
                      {task}
                    </li>
                  ))}
                </ul>
              );
            if (step.kind === "call")
              return (
                <p
                  class:list={["call", step.agentTool && "agent-tool"]}
                  data-step
                  data-call
                  data-completes={step.completes}
                >
                  <span class="glyph" aria-hidden="true" />
                  <code class="tool">{step.tool}</code>
                  {step.args && <code class="args">({step.args})</code>}
                  <span class="result">{step.result}</span>
                  <span class="ms">{step.ms}ms</span>
                </p>
              );
            if (step.kind === "progress")
              return (
                <div class="call progress" data-step data-call data-progress={step.total} data-completes={step.completes}>
                  <span class="glyph" aria-hidden="true" />
                  <code class="tool">{step.tool}</code>
                  <code class="args">({step.args})</code>
                  <span class="result">{step.result}</span>
                  <span class="ms">{(step.ms / 1000).toFixed(1)}s</span>
                  <span class="bar" aria-hidden="true">
                    <span class="fill" data-fill />
                  </span>
                  <span class="count" aria-hidden="true">
                    <span data-count>{step.total}</span>/{step.total}
                  </span>
                </div>
              );
            if (step.kind === "text")
              return (
                <p class="say" data-step>
                  {step.text}
                </p>
              );
            if (step.kind === "points")
              return (
                <ul class="points" data-step>
                  {step.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              );
            if (step.kind === "rows")
              return (
                <table class="rows" data-step>
                  <caption class="visually-hidden">Entregas pendientes</caption>
                  <tbody>
                    {step.rows.map((row) => (
                      <tr>
                        <td class="day">{row.day}</td>
                        <td class="time">{row.time}</td>
                        <td class="what">
                          <strong>{row.what}</strong>
                          <span>{row.where}</span>
                        </td>
                        <td class="flag">{row.flag && <span>{row.flag}</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              );
            return (
              <div class="files" data-step>
                <p class="folder">{step.folder}/</p>
                <ul>
                  {step.files.map((file) => (
                    <li>
                      <span>{file.name}</span>
                      {file.note && <em>{file.note}</em>}
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </section>
      ))
    }
  </div>

  <div class="composer" aria-hidden="true">
    <span class="caret">›</span>
    <span>Pregunta algo sobre tus materias</span>
    <kbd>Enter</kbd>
  </div>
</div>

<style>
  .session {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--term-bg);
    box-shadow: var(--term-shadow);
    overflow: hidden;
  }

  .chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    background: var(--term-bar);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .title {
    color: var(--text-3);
    white-space: nowrap;
  }

  .status {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ok);
    white-space: nowrap;
  }

  .led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-soft);
  }

  .tabs {
    display: flex;
    gap: 4px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    background: var(--term-bar);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs button {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-3);
    background: none;
    border: 0;
    padding: 9px 10px 10px;
    cursor: pointer;
    white-space: nowrap;
  }

  .tabs button:hover {
    color: var(--text);
  }

  .tabs button[aria-selected="true"] {
    color: var(--text);
  }

  .tabs button[aria-selected="true"]::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .screen {
    height: 520px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    mask-image: linear-gradient(transparent, black 22px);
  }

  .panel {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 20px 22px 24px;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .panel[hidden] {
    display: none;
  }

  .ask {
    position: relative;
    padding-left: 18px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text);
    min-height: 1.6em;
    margin-bottom: 6px;
  }

  .ask::before,
  .caret {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .ask::before {
    content: "›";
    position: absolute;
    left: 0;
  }

  .think {
    position: relative;
    padding-left: 18px;
    font-size: 0.86rem;
    font-style: italic;
    color: var(--text-3);
  }

  .think::before {
    content: "✻";
    position: absolute;
    left: 0;
    font-style: normal;
    color: var(--text-3);
  }

  .plan {
    list-style: none;
    margin: 2px 0;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-2);
  }

  .plan li {
    position: relative;
    padding-left: 20px;
    transition: color 0.3s ease;
  }

  .plan li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 9px;
    height: 9px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }

  .plan li.done {
    color: var(--text-3);
    text-decoration: line-through;
    text-decoration-color: var(--line-strong);
  }

  .plan li.done::before {
    content: "✓";
    border: 0;
    top: 0;
    width: auto;
    height: auto;
    color: var(--accent);
  }

  .call {
    display: grid;
    grid-template-columns: 14px auto minmax(0, 1fr) auto auto;
    align-items: baseline;
    column-gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .glyph {
    position: relative;
    align-self: center;
    width: 10px;
    height: 10px;
  }

  .glyph::before {
    content: "✓";
    position: absolute;
    inset: -4px 0 0;
    color: var(--accent);
    font-size: 0.82rem;
    line-height: 1;
  }

  .tool {
    color: var(--text);
    font-size: inherit;
    font-weight: 500;
  }

  .agent-tool .tool {
    color: var(--text-2);
  }

  .args {
    color: var(--text-3);
    font-size: inherit;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result {
    grid-column: 4;
    color: var(--text-2);
    white-space: nowrap;
  }

  .ms {
    grid-column: 5;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    color: var(--text-3);
    min-width: 5.2ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bar {
    grid-column: 2 / 5;
    height: 4px;
    margin: 6px 0 2px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .count {
    grid-column: 5;
    align-self: center;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .say {
    margin-top: 6px;
  }

  .rows {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.88rem;
  }

  .rows td {
    padding: 8px 0;
    border-top: 1px solid var(--line);
    vertical-align: baseline;
  }

  .rows tr:last-child td {
    border-bottom: 1px solid var(--line);
  }

  .day {
    width: 4.6em;
    color: var(--text-2);
  }

  .time {
    width: 3.8em;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    font-weight: 500;
  }

  .what strong {
    font-weight: 500;
  }

  .what span {
    display: block;
    color: var(--text-3);
    font-size: 0.8rem;
  }

  .flag {
    text-align: right;
  }

  .flag span {
    font-size: 0.72rem;
    color: var(--no);
    background: var(--no-soft);
    border-radius: 999px;
    padding: 2px 8px;
    white-space: nowrap;
  }

  .points {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
  }

  .points li::marker {
    color: var(--accent);
  }

  .files {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .folder {
    color: var(--accent);
    margin-bottom: 6px;
  }

  .files ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--line-strong);
    display: grid;
    gap: 3px;
  }

  .files li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .files em {
    font-style: normal;
    color: var(--text-3);
  }

  .composer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-top: 1px solid var(--line);
    background: var(--term-bar);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .composer kbd {
    margin-left: auto;
    font-size: 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    padding: 1px 6px;
  }

  :global(.motion) .panel [data-step]:not(.shown, .typing) {
    display: none;
  }

  :global(.motion) .panel [data-step].shown {
    animation: rise 0.3s ease;
  }

  :global(.motion) .panel [data-call]:not(.done) :is(.result, .ms) {
    visibility: hidden;
  }

  :global(.motion) .panel [data-call]:not(.done) .glyph::before {
    content: "";
    inset: 0;
    border: 1.5px solid var(--line-strong);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  :global(.motion) .panel .ask.typing::after {
    content: "";
    display: inline-block;
    width: 7px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: var(--accent);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 560px) {
    .chrome {
      grid-template-columns: auto 1fr;
    }

    .title {
      display: none;
    }

    .screen {
      height: 480px;
    }

    .panel {
      padding: 18px 14px 20px;
    }

    .call {
      grid-template-columns: 14px minmax(0, 1fr) auto;
    }

    .args,
    .ms {
      display: none;
    }

    .result,
    .count {
      grid-column: 3;
    }

    .bar {
      grid-column: 2 / 3;
    }

    .day {
      width: 4em;
    }

    .flag {
      display: none;
    }
  }
</style>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  for (const root of document.querySelectorAll<HTMLElement>("[data-session]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const screen = root.querySelector<HTMLElement>("[data-screen]");
    let run = 0;
    let autoplay = !reducedMotion;
    let visible = true;
    let advanceWhenVisible = false;
    const advance = () => select((tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true") + 1) % tabs.length);
    const follow = () => screen?.scrollTo({ top: screen.scrollHeight, behavior: "smooth" });

    const type = async (step: HTMLElement, live: () => boolean) => {
      const text = step.dataset.text ?? step.textContent?.trim() ?? "";
      step.dataset.text = text;
      step.textContent = "";
      step.classList.add("typing");
      for (let length = 1; length <= text.length; length++) {
        if (!live()) {
          step.textContent = text;
          return;
        }
        step.textContent = text.slice(0, length);
        await wait(7 + Math.random() * 11);
      }
      await wait(260);
    };

    const fillProgress = async (step: HTMLElement, live: () => boolean) => {
      const total = Number(step.dataset.progress);
      const fill = step.querySelector<HTMLElement>("[data-fill]");
      const count = step.querySelector<HTMLElement>("[data-count]");
      for (let done = 0; done <= total; done++) {
        if (!live()) return;
        if (fill) fill.style.width = `${(done / total) * 100}%`;
        if (count) count.textContent = String(done);
        await wait(1800 / total);
      }
    };

    const play = async (panel: HTMLElement, current: number, typePrompt: boolean) => {
      const steps = [...panel.querySelectorAll<HTMLElement>("[data-step]")];
      const tasks = [...panel.querySelectorAll<HTMLElement>("[data-task]")];
      const live = () => current === run;
      if (reducedMotion) return;
      for (const step of steps) step.classList.remove("shown", "done", "typing");
      for (const task of tasks) task.classList.remove("done");
      screen?.scrollTo({ top: 0 });

      for (const step of steps) {
        if (!live()) return;
        if (step.hasAttribute("data-type")) {
          if (typePrompt) await type(step, live);
          step.classList.add("shown");
          step.classList.remove("typing");
          await wait(200);
          continue;
        }
        step.classList.add("shown");
        follow();
        if (step.hasAttribute("data-call")) {
          if (step.hasAttribute("data-progress")) await fillProgress(step, live);
          else await wait(520 + Math.random() * 380);
          if (!live()) return;
          step.classList.add("done");
          const completes = step.dataset.completes;
          if (completes !== undefined) tasks[Number(completes)]?.classList.add("done");
          await wait(140);
        } else {
          await wait(step.classList.contains("think") ? 650 : 380);
        }
      }
      if (!live() || !autoplay) return;
      await wait(5600);
      if (!live() || !autoplay) return;
      if (visible) advance();
      else advanceWhenVisible = true;
    };

    const select = (index: number, typePrompt = true) => {
      run++;
      advanceWhenVisible = false;
      tabs.forEach((tab, position) => {
        const selected = position === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[position].hidden = !selected;
      });
      play(panels[index], run, typePrompt);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        autoplay = false;
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        autoplay = false;
        const next = (index + step + tabs.length) % tabs.length;
        tabs[next].focus();
        select(next);
      });
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && advanceWhenVisible && autoplay) advance();
    }).observe(root);

    select(0, false);
  }
</script>
